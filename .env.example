# Supabase — these values come from your Supabase project settings
# Get these from: https://app.supabase.com/project/<ref>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin panel password (set a strong, unique password here)
VITE_ADMIN_PASSWORD=your-secure-admin-password-here

# Database connection string (used by Drizzle ORM for migrations)
DATABASE_URL=postgresql://user:password@host:port/dbname
